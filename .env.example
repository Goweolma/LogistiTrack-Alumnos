# Valores exclusivos de demostración. Copiar a .env antes de levantar Compose.
# POSTGRES_PASSWORD y DATABASE_URL son obligatorios; mantener usuario, clave
# y base sincronizados. En DATABASE_URL, codificar caracteres reservados de la clave.
POSTGRES_DB=logistitrack
POSTGRES_USER=logisti
POSTGRES_PASSWORD=logisti123
DATABASE_URL=postgresql://logisti:logisti123@postgres:5432/logistitrack
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PREPARATION_DELAY_SECONDS=3
DELIVERY_STEP_DELAY_SECONDS=2
# Valores locales de demostración. Cambia las credenciales antes de publicar.
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
INITIAL_ADMIN_EMAIL=admin@ray-o.local
INITIAL_ADMIN_PASSWORD=AdminLocal2026!
COOKIE_SECURE=false

